# Copy to .env for local development. .env is gitignored and must never be committed.

# Connection string for the application's database role.
# This role deliberately has no UPDATE or DELETE grant on audit tables (from ticket 04).
DATABASE_URL=postgres://<user>:<password>@localhost:5432/schoolgrid

# Port the HTTP service listens on.
PORT=3000

# Log verbosity: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Requests one client address may make per window before being answered 429.
# Counted in process memory, so the limit applies per running instance.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
