# Copy to .env for local development. .env is gitignored and must never be committed.

# Connection string for the application's database role: a login that is a
# member of schoolgrid_app and nothing else. It has no UPDATE, DELETE, or
# TRUNCATE grant on Audit records, and the service refuses to start if it does.
# See docs/database-roles.md.
DATABASE_URL=postgres://schoolgrid_runtime:<password>@localhost:5432/schoolgrid

# Connection string for the schema owner, used only to apply migrations at
# startup. It never serves a request. Set it for local development, where the
# service migrating itself is the convenient thing. Leave it unset where the
# service must not hold the owner's credentials, as in production: there the
# database is migrated before the service starts, and the service only checks
# that it was, refusing to start if a migration is missing.
MIGRATION_DATABASE_URL=postgres://<owner>:<password>@localhost:5432/schoolgrid

# Port the HTTP service listens on.
PORT=3000

# The origin browsers reach SchoolGrid at: scheme, host and port, with no path.
# A change made with a browser's session cookie must carry this exact Origin.
# https, or http on localhost only, where browsers still keep a Secure cookie.
PUBLIC_ORIGIN=http://localhost:3000

# Log verbosity: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Requests one client address may make per window before being answered 429.
# Counted in process memory, so the limit applies per running instance.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# The request header holding the client's real address, for the rate limit
# alone; a request without it is keyed on its socket address. Leave it unset
# unless SchoolGrid runs behind a proxy that overwrites this header on every
# request: anywhere else any caller can send it, and so choose their own
# rate-limit key. Counts are still held per instance. On Vercel, set it to
# x-vercel-forwarded-for.
# CLIENT_ADDRESS_HEADER=
